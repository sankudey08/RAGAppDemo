# Ollama must be running locally (https://ollama.com/download).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ChromaDB data is kept outside source control by default.
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=rag_documents

# Character-based chunking for Phase 3.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Upload and retrieval defaults used by later phases.
MAX_UPLOAD_SIZE_MB=25
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.2

# Persistent semantic answer cache (Phase 8).
CACHE_ENABLED=true
CACHE_COLLECTION_NAME=rag_answer_cache
CACHE_SIMILARITY_THRESHOLD=0.92
LOG_LEVEL=INFO
